{
  "name": "cf-ai-pr-policy-reviewer",
  "version": "1.0.0",
  "private": true,
  "description": "A chat agent on Cloudflare that checks GitHub pull requests against a team's own engineering rules",
  "keywords": [
    "agents",
    "ai",
    "cloudflare"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "start": "vite dev",
    "deploy": "vite build && wrangler deploy",
    "types": "wrangler types env.d.ts",
    "format": "oxfmt --write .",
    "lint": "oxlint src/",
    "check": "oxfmt --check . && oxlint src/ && tsc && vitest run",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.180",
    "@cloudflare/ai-chat": "^0.12.2",
    "@cloudflare/kumo": "^2.19.0",
    "@phosphor-icons/react": "^2.1.10",
    "@streamdown/code": "^2.0.1",
    "agents": "^0.33.0",
    "ai": "^7.0.176",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "streamdown": "^2.8.0",
    "workers-ai-provider": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@cloudflare/vite-plugin": "^1.70.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261116.1": true,
    "workerd@1.20261117.1": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true
  }
}
